# Product Hunt developer token (https://www.producthunt.com/v2/oauth/applications -> create app -> "Create Token")
PRODUCTHUNT_TOKEN=
# Alternative to the token: API key + secret (client-credentials flow)
PRODUCTHUNT_CLIENT_ID=
PRODUCTHUNT_CLIENT_SECRET=

# Gemini (Google AI Studio key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
